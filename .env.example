# Copy to `.env` for local runs. Never commit `.env`.

# --- Run mode ---
# 1 = paper / dry run (no orders). 0 = live (only after Phase 7 is wired and tested).
DRY_RUN=1

# --- Polygon (optional; on-chain reads / wallet context later) ---
# POLYGON_RPC_URL=https://polygon-rpc.com

# --- Gamma API (Phase 2 market discovery) ---
# GAMMA_API_BASE=https://gamma-api.polymarket.com
# PM_REGISTRY_PATH=data/markets.db

# --- CEX market data (Phase 3; Binance combined stream base) ---
# BINANCE_WS_BASE=wss://stream.binance.com:9443
# Polymarket CLOB market channel (public)
# POLYMARKET_CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- Polymarket CLOB signing & API (Phase 7 only; keep empty until live) ---
# POLYMARKET_PRIVATE_KEY=
# Polymarket L2 credentials are derived from the signer; set if not using auto-derive:
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# --- Risk limits (Phase 5) ---
# BANKROLL_USD=1000
# MAX_NOTIONAL_USD=500
# MAX_MARKET_NOTIONAL_USD=150
# MAX_ORDER_NOTIONAL_USD=50
# DAILY_LOSS_LIMIT_USD=100
# KELLY_FRACTION=0.25
# MAX_ORDERS_PER_MINUTE=30
# PM_RISK_STATE_PATH=data/risk_state.json
# PM_KILL_SWITCH=0
# PM_KILL_FILE=data/kill

# --- Paper trading (Phase 6) ---
# STRATEGY_MIN_EDGE=0.02
# STRATEGY_SIGMA_FLOOR=0.01
# PAPER_EVAL_INTERVAL_S=0.5
# PAPER_ORDER_TYPE=FAK
